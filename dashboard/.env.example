# Stacks Console — configuration and secrets (TEMPLATE)
# `./setup` (next to this file) writes `.env` from this template: it generates the four secrets
# below, sets DATA_ROOT and APP_UID, and never replaces a `.env` that already exists.
# By hand instead: copy to `.env` next to docker-compose.yml, `chmod 600 .env`, never commit it,
# and generate the secrets, for example:
#   POSTGRES_PASSWORD:    openssl rand -base64 24 | tr -dc A-Za-z0-9 | head -c 28
#   JWT_SECRET:           openssl rand -hex 32
#   GSS_SECRET_KEY:       openssl rand -hex 32
#   SEED_ADMIN_PASSWORD:  openssl rand -base64 18 | tr -dc A-Za-z0-9 | head -c 16

# Names with the prefixes GSS_, POSTGRES_, JWT_, SMTP_, SEED_ADMIN_, DASHBOARD_, WATCHDOG_,
# BACKUP_ and DB_ belong to this project: one that is not a known setting (a typo) is reported
# in the API log at start and otherwise ignored.

# --- Compose project and images ---
# Name of this installation's compose project (default: stacks-console); the containers are
# called <project>-<service>-1. A SECOND installation on the same host needs its own name here,
# its own DASHBOARD_PORT and its own GAME_NETWORK (below). With the name in this file,
# `docker compose …` in this directory finds the right stack without `-p`.
# COMPOSE_PROJECT_NAME=stacks-console
# Release of the prebuilt console images (ghcr.io/juice-de-orange/stacks-console-api and -web)
# that `docker compose up -d` pulls, e.g. 0.2.0. Default: latest. An image that is already on
# the host is used as it is: to update, `docker compose pull && docker compose up -d`.
# `docker compose up -d --build` builds both from this checkout instead and tags them with the
# same name; a plain `up -d` falls back to that build only if the pull fails.
# GSS_VERSION=latest

# --- Games ---
# Games switched on at the very first start (comma list of minecraft, factorio, valheim, pz,
# arma_reforger, vintagestory, avorion, or `all`). Empty: none, the first-run screen asks. After the
# first start the admin chooses under Settings → Games and this value changes nothing any more.
# GSS_GAMES=minecraft
# Image of the steamcmd helper that downloads Steam workshop items (only pulled when an active
# game needs it, today Project Zomboid). Build it yourself with
# `docker build -t <name> images/steamcmd` and put that name here.
# GSS_STEAMCMD_IMAGE=ghcr.io/juice-de-orange/stacks-console-steamcmd:1
# Runner image that new Vintage Story servers start with (pulled when the container is created).
# To build it yourself: `docker build -t <name> images/vintagestory`, and put that name here.
# GSS_VS_RUNNER_IMAGE=ghcr.io/juice-de-orange/stacks-console-vintagestory-runner:1

# --- Postgres ---
POSTGRES_USER=stacks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stacks

# --- Auth ---
# Must be at least 32 characters. The backend refuses to start without it, on the built-in
# default or on a shorter secret — the placeholder below is too short on purpose.
JWT_SECRET=change-me-long-random
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
# Encrypts the game-server passwords entered in the dashboard (stored in the database). At least
# 32 characters; the backend refuses to start without it. Keep it with your backups: a database
# restored without this key has unreadable passwords (they then have to be entered again).
GSS_SECRET_KEY=change-me-long-random

# --- Client addresses behind reverse proxies ---
# The login throttle counts per client address. The API believes X-Forwarded-For /
# CF-Connecting-IP only from the peers listed here (IP addresses, CIDR ranges or host names;
# comma-separated or a JSON list). The compose file defaults this to `console-web`, the service
# name of the bundled Caddy, which passes on one validated address. Set it only if you run the
# API behind a different proxy; set it empty to ignore the headers altogether.
# TRUSTED_PROXIES=console-web
# Whose X-Forwarded-For the bundled Caddy believes (space-separated addresses or CIDR ranges).
# Default: private and loopback addresses, which covers a reverse proxy or tunnel on this host.
# If your proxy appends to X-Forwarded-For rather than replacing it, that is fine; if it sits
# behind a CDN, list the CDN's ranges here or let your proxy resolve the real client address.
# CADDY_TRUSTED_PROXIES=private_ranges

# --- Bootstrap admin (seeded on the first start only, ignored afterwards) ---
# The account must change its password on first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-shown-once

# --- Host layout ---
# Directory on the HOST that holds every game server's data. It is bound into the API container
# under the same path, so it must be an absolute path, and its content must be owned by APP_UID.
# `./setup` sets it to `data/servers` in this directory (or to `./setup --data-root PATH`).
DATA_ROOT=/srv/gameservers
# uid the API container runs as (build arg). The Factorio, Valheim, Minecraft and Vintage Story
# containers the dashboard creates run their game as this same uid and gid, so that both sides
# can write the same files. The prebuilt image runs as 1000; another value needs `--build`.
# `./setup` sets it to your own uid when that is not 1000.
APP_UID=1000
# Docker network that the dashboard and the game servers share (created by docker-compose.yml).
# New servers join it by default. Its name is the same in every compose project, so a second
# installation on this host needs a name of its own here.
GAME_NETWORK=gameserver-net
# Host port of the web UI, and the host address it is published on. Default 127.0.0.1: local
# only — put your own TLS-terminating reverse proxy or tunnel in front of it, or let the bundled
# Caddy do HTTPS (next block). 0.0.0.0 publishes it on every interface, without TLS. An IPv6 address goes in brackets: [::1]. Caddy believes
# X-Forwarded-For from every private address (CADDY_TRUSTED_PROXIES above): if clients on your
# network reach it directly, narrow that setting to your proxy's address.
DASHBOARD_PORT=8080
# DASHBOARD_BIND=127.0.0.1
# Optional allowlist of host directories a server's data_dir may live under. Default: DATA_ROOT
# alone. Comma-separated or a JSON list. Every extra directory also needs its own same-path bind
# mount on `console-api`: docker-compose.override.example.yml shows both parts.
# ALLOWED_DATA_ROOTS=/srv/gameservers,/mnt/games

# --- HTTPS by the bundled Caddy (optional) ---
# Without these settings the dashboard speaks plain HTTP on DASHBOARD_BIND:DASHBOARD_PORT, and
# TLS is up to a reverse proxy or tunnel of your own. With them, an extra Caddy (`console-tls`,
# compose profile `https`) answers on ports 80 and 443 of every host interface, obtains and
# renews a certificate for DASHBOARD_DOMAIN by itself (Let's Encrypt), redirects HTTP to HTTPS
# and sends HSTS. The local HTTP port above stays as it is.
# Requirements: DASHBOARD_DOMAIN resolves to this host from the internet, and ports 80 and 443
# reach it (router, firewall) — the certificate authority checks the name over them.
# Switch it on with all three lines; a profile you already use goes in the same list
# (COMPOSE_PROFILES=https,<other>). Then `docker compose up -d`. To switch it off again, remove
# the lines and run `docker compose rm -sf console-tls` — `up -d` alone leaves it running.
# COMPOSE_PROFILES=https
# DASHBOARD_DOMAIN=dashboard.example.com
# ACME_EMAIL=admin@example.com
# Host ports of console-tls. Change them only if something forwards 80/443 to other ports: the
# certificate authority always connects to 80 and 443.
# DASHBOARD_HTTP_PORT=80
# DASHBOARD_HTTPS_PORT=443
# FOR TESTING ONLY: `internal` takes the certificate from Caddy's own certificate authority (no
# internet access needed, no ACME_EMAIL; every browser warns). Default: acme.
# ACME_CA=acme

# --- Firewall helper (optional, compose profile `firewall`) ---
# Only useful if this host's firewall blocks the published game ports in Docker's DOCKER-USER
# chain (Docker bypasses ufw/firewalld for published ports; DOCKER-USER is where a default-deny
# for containers goes). The helper `console-firewall` then opens exactly the published ports of
# the enabled servers there, through a chain of its own (GSS-ALLOW) with ACCEPT rules only. It
# never blocks anything and never changes other rules. What it would change is shown under
# Settings → Network; nothing is opened before an admin applies it, while ports of a server that
# is switched off or removed close by themselves within a minute.
# It runs in the host's network namespace with NET_ADMIN (no Docker socket) — read the trust
# boundary in docs/security.md first.
# Switch it on with both lines (a profile you already use goes in the same list, e.g.
# COMPOSE_PROFILES=https,firewall), then `docker compose up -d`. To switch it off again:
# `docker compose run --rm console-firewall remove`, remove the lines, `docker compose rm -sf
# console-firewall`.
# COMPOSE_PROFILES=firewall
# Shared by the API and the helper, at least 32 characters: openssl rand -hex 32
# GSS_FIREWALL_TOKEN=
# Networks the opened ports accept connections from (CIDR ranges, comma-separated, IPv4 and/or
# IPv6). Empty: from anywhere. Listing only IPv4 networks opens nothing over IPv6.
# GSS_FIREWALL_SOURCES=198.51.100.0/24
# The only ports the helper opens at all, whatever the dashboard asks for. Default 1024-65535,
# which keeps SSH (22) and every other system port out of its reach.
# GSS_FIREWALL_PORT_RANGE=1024-65535
# Which iptables Docker uses on this host: auto (default) finds out, nft or legacy settle it if
# both have a DOCKER-USER chain (`iptables --version` on the host says nf_tables or legacy).
# Legacy iptables also needs the capability NET_RAW: add `cap_add: [NET_RAW]` for
# console-firewall in a docker-compose.override.yml.
# GSS_FIREWALL_BACKEND=auto
# How often the helper restores the applied rules if something removed them (a firewall reload,
# a reboot), in seconds. 0: only at start.
# GSS_FIREWALL_RECONCILE_SECONDS=60

# --- Database files and the nightly database dump (sidecar `console-backup`) ---
# Host directory of the Postgres data files. Relative paths are relative to this directory.
# DB_DATA_DIR=./data/db
# Host directory the nightly dumps go to (`stacks-console-<date>-<time>.sql.gz`), and the
# uid:gid they are written as. If root owns the directory (Docker creates a missing one as
# root), the sidecar hands it to this owner; a directory you created for someone else is left
# alone and must be writable for this owner.
# DB_BACKUP_DIR=./db-backups
# DB_BACKUP_OWNER=1000:1000
# Time of the daily dump, in the sidecar's zone, which is UTC (it does not follow SCHEDULER_TZ).
# Keep it clear of the weekly world backup at 04:00 scheduler time.
# DB_BACKUP_HOUR=2
# DB_BACKUP_MINUTE=30
# Dumps older than this many days are removed; files you put there yourself are never touched.
# DB_BACKUP_KEEP_DAYS=30

# --- Game passwords ---
# Optional: a server's console password can instead be entered in the dashboard ("Add server" or
# the server's setup page), where it is stored encrypted with GSS_SECRET_KEY. So can Project
# Zomboid's in-game admin password (edit page) and the join passwords of Project Zomboid and
# Valheim (Configuration page). A variable set here WINS over the stored value.
# `config.py` does NOT know these names. A server row names the variable it uses
# (`rcon_password_env`, for Project Zomboid also `extra.admin_password_env` /
# `extra.password_env`) and the backend reads it from the environment at runtime; compose
# passes this whole file to the API container (`env_file`). The names below are conventions —
# use any name, as long as the server row refers to it.
# Generate each one like POSTGRES_PASSWORD above. A server that the dashboard adopts instead of
# creating must get the value its container already runs with.
PZ_RCON_PW=
# Join and admin password of a Project Zomboid server:
PZ_SERVER_PW=
PZ_ADMIN_PW=
MC_RCON_PW=
VS_RCON_PW=
# Arma Reforger: at most 32 characters, no spaces.
REFORGER_RCON_PW=
# Factorio and Avorion: THE FILE WINS, NOT THIS VARIABLE. Neither game has an environment
# variable for the RCON password; what is in their file IS the running server's password. The
# value here is only the initial fill when the server is created. If the two differ, the
# dashboard logs a warning and uses the file. To change the password, change the FILE (Avorion:
# with the server stopped), not this line.
#   * FACTORIO_RCON_PW is written to `config/rconpw` on creation. Empty: the image rolls its own
#     on first start and the dashboard reads it back from the file.
#   * AVORION_RCON_PW ends up in `server.ini` in the galaxy folder. Avorion does not start RCON
#     at all without a password, so the driver generates one if this is empty and reads it back
#     from the same file.
#   * Valheim needs none: its dedicated server has no remote console.
FACTORIO_RCON_PW=
AVORION_RCON_PW=

# --- Join page ---
# Address under which the GAME SERVERS are reachable from outside (not the dashboard), e.g.
# 203.0.113.10 or play.example.com. Empty: the join page says "no address configured" instead
# of showing a wrong one. Can be overridden per server via `extra.public_host`.
PUBLIC_HOST=
# Optional convenience links (Project Zomboid only):
# MOD_COLLECTION_URL=https://steamcommunity.com/sharedfiles/filedetails/?id=XXXXXXXX
# COMMUNITY_URL=https://discord.gg/XXXXXXXX

# --- Reachability: check from outside (server page → Reachability) ---
# The checklist and the check from inside always work and send nothing anywhere. The check from
# OUTSIDE asks third-party services to look at the server's public IPv4 address from the
# internet, so it is off until you switch it on. What they receive: the IPv4 address (a DNS name
# in PUBLIC_HOST is resolved on this host first) and, for mcstatus.io and portchecker.io, the
# port numbers — no key, no server name, no password. Answers are cached for one minute.
#   * Steam Web API (GetServersAtAddress, no key): is a Valheim/Project Zomboid/Avorion/
#     Arma Reforger server listed at that address?
#   * mcstatus.io: a Minecraft status ping from the internet.
#   * portchecker.io: a TCP connection from the internet, for the other TCP ports.
# UDP ports without such a service (Factorio, extra ports) are reported as "not checkable".
# GSS_REACHABILITY_PROBES=on
# Each service can be switched off on its own:
# GSS_REACHABILITY_STEAM=off
# GSS_REACHABILITY_MCSTATUS=off
# GSS_REACHABILITY_PORTCHECK=off
# mcstatus.io and portchecker.io are open source; point these at your own instance if you run one:
# GSS_REACHABILITY_MCSTATUS_URL=https://api.mcstatus.io
# GSS_REACHABILITY_PORTCHECK_URL=https://portchecker.io

# --- Watchdog (RCON liveness: restarts a hung game process) ---
# Acts only when the CONTAINER is running and RCON stays dead for WATCHDOG_FAIL_THRESHOLD
# consecutive 60-second checks — a crashed container is the job of `unless-stopped`. The boot
# guard keeps it from starting a configuration that is known to be broken, crash-loop detection
# stops it from repeating a restart that does not help, and the cooldown prevents restart loops.
WATCHDOG_ENABLED=true
WATCHDOG_FAIL_THRESHOLD=3
WATCHDOG_COOLDOWN_MIN=20

# --- Automatic version change (hotfixes of the same minor version only) ---
# Pulls a hotfix at 04:45 if one is available AND demonstrably nobody is playing. Why: a server
# pinned to x.y.0 becomes unjoinable once the game clients have auto-updated to x.y.3, and
# Project Zomboid does not report the mismatch — the client just hangs while joining.
# The limit is deliberately tight: 42.20.0 -> 42.20.3 is done, 42.20 -> 42.21 is NOT. The boot
# proof shows "the server starts", not "the world is intact" or "the mods still work".
# An unreachable RCON means "unknown", not "empty" — then nothing is updated.
# WHICH servers the job touches is decided by the game driver, not here: PZ, Factorio, Avorion,
# Minecraft and Vintage Story follow hotfixes; Valheim and Reforger fetch the game on every
# start anyway.
AUTO_UPDATE_ENABLED=false

# --- Time ---
# Time zone for EVERYTHING with a fixed time of day: the nightly jobs (backup Sun 04:00, prune
# 04:10, catalogue 04:20, clean-up 04:30/40/50, auto-update 04:45, history prune 05:10) AND
# every restart and broadcast time an operator enters.
# The default is UTC. Changing it on a running installation shifts EVERY stored time by the
# zone offset at once, so decide it deliberately. The active zone is shown next to the time
# field on the schedule page. An unknown zone falls back to UTC with a log message.
SCHEDULER_TZ=UTC

# --- Retention ---
# Metric samples (players/RAM/CPU for the history charts), in days.
METRICS_RETENTION_DAYS=30
# Job tables, pruned daily at 05:10. `0` means: keep forever. `player_events` feeds the
# leaderboard and the death map, so a short period there is data loss. `player_sessions` is
# deliberately never pruned (play time, leaderboard and heatmap come from it).
INCIDENT_RETENTION_DAYS=365
PLAYER_EVENT_RETENTION_DAYS=730
OPERATION_RETENTION_DAYS=180
# Weekly world backups: retention by age AND by total size PER SERVER. A large world can be
# several GB per archive, so age alone is no limit. Deleted oldest first; BACKUP_KEEP_MIN
# archives always stay, even if they exceed the size limit (a warning is logged then).
BACKUP_RETENTION_DAYS=90
BACKUP_MAX_GB_PER_SERVER=12
BACKUP_KEEP_MIN=2
