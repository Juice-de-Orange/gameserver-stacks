# --- Image -------------------------------------------------------------------
# Tag of rfvgyhn/avorion. The tag IS the game version (stable builds: <version>.<build>,
# beta builds end in -beta). Never move a galaxy from a beta tag back to a stable one.
AVORION_TAG=2.5.13.44140

# --- Network -----------------------------------------------------------------
# Game port, TCP and UDP. Players connect to this one.
AVORION_PORT=27000
# Query port, UDP.
AVORION_QUERY_PORT=27003
# Steam query port, UDP.
AVORION_STEAM_QUERY_PORT=27020
# Steam master server port, UDP.
AVORION_STEAM_MASTER_PORT=27021

# --- Administration (required) -----------------------------------------------
# SteamID64 (17 digits) of the first server administrator. Passed as --admin at every start.
AVORION_ADMIN=

# --- Secrets (required) ------------------------------------------------------
# RCON password for the `rcon` tools service. Avorion reads its own copy from `rconPassword` in
# data/galaxy/server.ini: put the SAME value there while the server is stopped (README).
# Generate one with letters and digits only: openssl rand -hex 24
AVORION_RCON_PASSWORD=

# --- Tools -------------------------------------------------------------------
# Tag of itzg/rcon-cli, used by `docker compose run --rm rcon <command>`.
RCON_CLI_TAG=1.7.7
