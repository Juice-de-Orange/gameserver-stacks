# --- Image -------------------------------------------------------------------
# Tag of devidian/vintagestory. static-v<version> contains exactly that game version;
# players need a matching client. The image has no variable to pick another version.
VINTAGESTORY_TAG=static-v1.22.6

# --- Network -----------------------------------------------------------------
# Host port players connect to, published on TCP and UDP. The server inside the
# container always listens on 42420 (leave "Port" in data/serverconfig.json at 42420).
VINTAGESTORY_PORT=42420

# --- Optional remote console (Vintage RCON mod) ------------------------------
# Tag of itzg/rcon-cli, used by `docker compose run --rm rcon ...`.
RCON_CLI_TAG=1.7.7
# Must equal "Port" in the mod's vsrcon.json. Internal only, never published.
VINTAGESTORY_RCON_PORT=42425

# RCON password for the Vintage RCON mod; put the same value into "Password" in
# vsrcon.json. Only needed if you install the mod — uncomment and set it then.
# Generate one: openssl rand -hex 24
# VINTAGESTORY_RCON_PASSWORD=
