# --- Image -------------------------------------------------------------------
# Game version = tag of factoriotools/factorio (the compose file appends -rootless).
# Clients must run exactly this version. Never go back to an older version with the same world.
FACTORIO_TAG=2.0.77

# --- Network -----------------------------------------------------------------
# UDP port players connect to. Used on the host and inside the container, because Factorio
# announces it to the server browser.
FACTORIO_PORT=34197

# --- World -------------------------------------------------------------------
# true: load the newest file in data/saves. false: load FACTORIO_SAVE_NAME.
FACTORIO_LOAD_LATEST_SAVE=true
# true: create data/saves/<FACTORIO_SAVE_NAME>.zip if it does not exist yet.
# With no save at all, a new map (_autosave1) is created regardless of this value.
FACTORIO_GENERATE_NEW_SAVE=false
# Save file name without .zip. Only used when one of the two values above asks for it.
FACTORIO_SAVE_NAME=world

# --- Expansion and mods ------------------------------------------------------
# true: enable the Space Age mods (space-age, quality, elevated-rails). false: base game only.
# A space-separated list such as "elevated-rails" enables only those.
FACTORIO_DLC_SPACE_AGE=true
# true: update enabled mods from the mod portal at every start. Needs username and token in
# data/config/server-settings.json. Keep false unless you want the mod set to change on its own.
FACTORIO_UPDATE_MODS_ON_START=false

# --- Tools -------------------------------------------------------------------
# Tag of itzg/rcon-cli for `docker compose run --rm rcon <command>`.
RCON_CLI_TAG=1.7.7

# --- Secrets (required) ------------------------------------------------------
# RCON password, written to data/config/rconpw at every start. Generate one: openssl rand -base64 24
FACTORIO_RCON_PASSWORD=
