# --- Image -------------------------------------------------------------------
# Tag of ghcr.io/community-valheim-tools/valheim-server. This is the image version, NOT the game
# version: the image installs the current Valheim server from Steam at every start.
VALHEIM_TAG=1.4.0

# --- Network -----------------------------------------------------------------
# UDP game port. Host and container use the same number because Valheim announces it to Steam.
VALHEIM_PORT=2456
# UDP Steam query port (A2S). Valheim always uses VALHEIM_PORT + 1; keep the two in step.
VALHEIM_QUERY_PORT=2457
# UDP port for crossplay and for mods that talk over game port + 2. Keep it at VALHEIM_PORT + 2.
VALHEIM_CROSSPLAY_PORT=2458

# --- Server ------------------------------------------------------------------
# Name in the server browser. Must not contain VALHEIM_SERVER_PASS.
VALHEIM_SERVER_NAME=My Valheim Server
# World to load. Changing it loads (or creates) a DIFFERENT world; the old one stays on disk.
VALHEIM_WORLD_NAME=Dedicated
# true = listed in the server browser and answers Steam queries. false = hidden, players join by
# IP, and the query port no longer answers (status tools see nothing).
VALHEIM_PUBLIC=true
# true = accept non-Steam clients (Xbox, Microsoft Store, ...). Some mods do not work with it.
VALHEIM_CROSSPLAY=false
# true = load BepInEx mods from data/config/bepinex/plugins/.
VALHEIM_BEPINEX=false
# Optional extra Valheim server arguments, passed through unchanged. May stay empty.
VALHEIM_SERVER_ARGS=

# --- Updates and restarts (cron, container time zone) ------------------------
# Game update check while nobody is online; an update restarts the server. Empty = off (the game
# is still updated at every container start).
VALHEIM_UPDATE_CRON="*/15 * * * *"
# Daily server restart while nobody is online (image default). Empty = off.
VALHEIM_RESTART_CRON="10 5 * * *"

# --- Container user ----------------------------------------------------------
# The game runs as this UID/GID and owns ./data after the first start.
PUID=1000
PGID=1000
# Container time zone: log timestamps and the cron schedules above.
TZ=Etc/UTC

# --- Secrets (required) ------------------------------------------------------
# Join password, at least 5 characters, must not appear in VALHEIM_SERVER_NAME. Every player needs
# it, so make it typeable. Generate one: openssl rand -hex 8
VALHEIM_SERVER_PASS=
