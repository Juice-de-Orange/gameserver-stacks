# --- Image -------------------------------------------------------------------
# Tag of itzg/minecraft-server: <image release>-<Java runtime>. It is NOT the game version.
# Paper 26.1 and newer need Java 25, so keep a -java25 tag for those versions.
MINECRAFT_TAG=2026.9.2-java25

# --- Game --------------------------------------------------------------------
# Minecraft version Paper runs. Clients must use exactly this version.
# At every start the image installs the newest default-channel Paper build for it.
MINECRAFT_VERSION=26.2

# Accept the Minecraft EULA (https://www.minecraft.net/en-us/eula) by setting this to TRUE.
# Required: the server does not start without it.
MINECRAFT_EULA=

# Java heap for the server (sets -Xms and -Xmx). The host needs this plus about 25 %.
MINECRAFT_MEMORY=4G

# Text shown under the server in the multiplayer list.
MINECRAFT_MOTD=A Paper Minecraft server

# peaceful, easy, normal or hard.
MINECRAFT_DIFFICULTY=easy

# true: only players on the whitelist can join (add them with "whitelist add <name>").
# false: anyone with a Minecraft account can join.
MINECRAFT_ENABLE_WHITELIST=true

# --- Network -----------------------------------------------------------------
# TCP port players connect to.
MINECRAFT_PORT=25565

# Simple Voice Chat UDP port, only read by docker-compose.override.yml when you enable voice
# chat (see README, "Mods and plugins"). Must match "port" in the plugin's config.
# MINECRAFT_VOICE_PORT=24454

# --- Secrets (required) ------------------------------------------------------
# RCON password (RCON is never published). Generate one: openssl rand -hex 24
MINECRAFT_RCON_PASSWORD=

# --- Host --------------------------------------------------------------------
# UID/GID the server runs as; ./data is chowned to this UID on start.
PUID=1000
PGID=1000
TZ=Etc/UTC

# Tag of itzg/rcon-cli for "docker compose run --rm rcon <command>".
RCON_CLI_TAG=1.7.7
