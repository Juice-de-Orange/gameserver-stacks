# --- Image -------------------------------------------------------------------
# Tag of danixu86/project-zomboid-dedicated-server. The tag IS the game build (42.21 here);
# players' clients must run the same build. Use *-release tags; bump deliberately (see README).
ZOMBOID_TAG=42.21-release-2

# --- Server identity ---------------------------------------------------------
# Internal name: file names in data/zomboid/Server/ and the world folder. Letters, digits and
# underscores only (spaces break the admin account). Changing it later starts a new world.
ZOMBOID_SERVER_NAME=servertest
# Name shown in the in-game server browser. Rewritten into the .ini at every start.
ZOMBOID_DISPLAY_NAME=My Project Zomboid Server
# true lists the server in the in-game browser, false hides it. Rewritten at every start.
ZOMBOID_PUBLIC=false

# --- Network -----------------------------------------------------------------
# UDP game port (DefaultPort). Used on both sides of the mapping and passed to the server.
ZOMBOID_PORT=16261
# Second UDP port for direct connections (UDPPort in the .ini). Rewritten at every start.
ZOMBOID_UDP_PORT=16262
# RCON port inside the block's network. Must equal RCONPort= in the .ini. Never published.
ZOMBOID_RCON_PORT=27015

# --- Memory ------------------------------------------------------------------
# JVM heap (-Xms / -Xmx). The host needs free RAM above MAX for the JVM itself and the OS.
ZOMBOID_MIN_MEMORY=2048m
ZOMBOID_MAX_MEMORY=4096m

# --- Admin -------------------------------------------------------------------
# In-game admin account. Only used when the server data is created; renaming it later does not
# rename the existing admin.
ZOMBOID_ADMIN_USERNAME=admin

# --- Secrets (required) ------------------------------------------------------
# Admin account password. Generate one: openssl rand -base64 24
ZOMBOID_ADMIN_PASSWORD=
# RCON password. Generate one: openssl rand -base64 24
ZOMBOID_RCON_PASSWORD=

# --- Join password (optional) ------------------------------------------------
# Password players type to join. Empty = keep the Password= line of the .ini as it is (on a new
# server: no password). Generate one: openssl rand -base64 12
ZOMBOID_PASSWORD=

# --- Tools -------------------------------------------------------------------
# Tag of itzg/rcon-cli, used by `docker compose run --rm rcon <command>`.
RCON_CLI_TAG=1.7.7
