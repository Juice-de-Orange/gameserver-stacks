# --- Image -------------------------------------------------------------------
# Tag of ghcr.io/acemod/arma-reforger. The image only publishes `latest`, `edge` and
# `sha-<commit>` tags. The tag pins the wrapper (launcher, SteamCMD, base OS), NOT the game:
# the game server is downloaded from Steam and updated on every container start.
REFORGER_TAG=sha-d042142

# --- Network -----------------------------------------------------------------
# UDP game port. Used on both sides of the port mapping and announced to the Bohemia backend.
REFORGER_PORT=2001
# UDP port for A2S (Steam query) requests; the image's health check uses it too.
REFORGER_A2S_PORT=17777
# Public IPv4 address registered with the server browser. Empty = detected by the backend.
# Set it (e.g. 203.0.113.10) only if the server shows up with a wrong address.
REFORGER_PUBLIC_ADDRESS=

# --- Server ------------------------------------------------------------------
# docker_generated = build the server config from the variables in this file on every start.
# A file name such as config.json = use data/config/config.json verbatim and ignore the
# game/RCON variables below (see README, "Using your own config.json").
REFORGER_CONFIG=docker_generated
# Name shown in the server browser (0..100 characters).
REFORGER_SERVER_NAME=My Arma Reforger Server
# Scenario .conf path. Empty = image default, Conflict - Everon.
# Game Master - Everon: {59AD59368755F41A}Missions/21_GM_Eden.conf
# Game Master - Arland: {2BBBE828037C6F4B}Missions/22_GM_Arland.conf
REFORGER_SCENARIO_ID=
# Maximum number of players (1..128).
REFORGER_MAX_PLAYERS=32
# true = listed in the server browser.
REFORGER_VISIBLE=true
# Password to join. Empty = open server.
REFORGER_GAME_PASSWORD=
# Comma-separated Bohemia identity IDs and/or Steam IDs of admins, no spaces.
# Listed admins can use #login without the password and open the Game Master menu.
REFORGER_ADMINS=
# Platforms allowed to join: PLATFORM_PC, PLATFORM_XBL, PLATFORM_PSN (comma-separated).
# See README, "Crossplay", before adding consoles to a server with mods.
REFORGER_SUPPORTED_PLATFORMS=PLATFORM_PC
# true = accept all platforms (adds the missing ones to the list above).
REFORGER_CROSS_PLATFORM=false
# Workshop mods: comma-separated mod IDs, optional =version, no spaces.
# Example: 0123456789ABCDEF=1.0.0,FEDCBA9876543210
REFORGER_MODS=
# Server frame-rate cap. Bohemia recommends 60..120; uncapped, the server takes all CPU it gets.
REFORGER_MAX_FPS=120
# Extra startup parameters, e.g. -loadSessionSave to resume the latest session save.
REFORGER_PARAMS=

# --- Secrets (required) ------------------------------------------------------
# BattlEye RCON password: 3..32 characters, no spaces. Generate one: openssl rand -hex 12
REFORGER_RCON_PASSWORD=
# In-game admin password for "#login <password>", no spaces. Generate one: openssl rand -hex 12
REFORGER_ADMIN_PASSWORD=
